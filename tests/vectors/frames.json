    {
      "name": "cmd_frame_e5_04",
      "source": "tests/test_encoders.py::test_cmd_frame",
      "lines": "13-17",
      "stated": [
        "fr = A.cmd_frame(0xE5, b\"\\x04\")",
        "assert len(fr) == 256",
        "assert fr[0] == 0xE5 and fr[1:5] == A.MAGIC and fr[5] == 0x04",
        "assert not any(fr[6:]), \"tail must be zero-padded\""
      ],
      "call": "cmd_frame",
      "input": { "opcode": "0xE5", "tail": "04" },
      "expect": {
        "len": 256,
        "at": [
          { "offset": 0, "hex": "e5" },
          { "offset": 1, "hex": "cb 55 ac 38" },
          { "offset": 5, "hex": "04" }
        ],
        "zero_from": 6
      }
    },
    {
      "name": "selftest_cmd_frame_e5_04",
      "source": "aorus_lcd.py::run_selftest::cmd_frame",
      "lines": "421",
      "stated": [
        "(\"cmd_frame\", lambda: cmd_frame(0xE5, b\"\\x04\")[:6] == bytes([0xE5]) + MAGIC + b\"\\x04\"),"
      ],
      "call": "cmd_frame",
      "input": { "opcode": "0xE5", "tail": "04" },
      "expect": {
        "at": [ { "offset": 0, "hex": "e5 cb 55 ac 38 04" } ]
      }
    },
