    {
      "name": "chunk_payload_pads_and_counts",
      "source": "tests/test_encoders.py::test_chunk_payload_pads_and_counts",
      "lines": "54-60",
      "stated": [
        "p = bytes(range(256)) * 2 + b\"\\xAA\" * 10           # 522 bytes -> 3 chunks",
        "chunks = A.chunk_payload(p)",
        "assert len(chunks) == len(p) // 256 + 1 == 3",
        "assert all(len(c) == 256 for c in chunks)",
        "assert b\"\".join(chunks)[: len(p)] == p",
        "assert not any(b\"\".join(chunks)[len(p):]), \"padding must be zero\""
      ],
      "call": "chunk_payload",
      "input": {
        "payload": [
          { "byte_range": [0, 256], "repeat": 2 },
          { "hex": "aa", "repeat": 10 }
        ]
      },
      "expect": {
        "count": 3,
        "each_len": 256,
        "joined": {
          "at": [
            { "offset": 0, "byte_range": [0, 256], "repeat": 2 },
            { "offset": 512, "hex": "aa", "repeat": 10 }
          ],
          "zero_from": 522
        }
      }
    },
    {
      "name": "chunk_payload_exact_multiple_adds_full_pad_chunk",
      "source": "tests/test_encoders.py::test_chunk_payload_exact_multiple_adds_full_pad_chunk",
      "lines": "63-69",
      "stated": [
        "# protocol-observed: chunk count is ALWAYS usize//256 + 1, so an exact",
        "# multiple gets one extra all-zero chunk. Do not \"fix\" this.",
        "p = b\"\\x11\" * 512",
        "chunks = A.chunk_payload(p)",
        "assert len(chunks) == 3",
        "assert chunks[2] == bytes(256)"
      ],
      "call": "chunk_payload",
      "input": { "payload": [ { "hex": "11", "repeat": 512 } ] },
      "expect": {
        "count": 3,
        "items": [
          { "index": 2, "exact": [ { "hex": "00", "repeat": 256 } ] }
        ]
      }
    },
