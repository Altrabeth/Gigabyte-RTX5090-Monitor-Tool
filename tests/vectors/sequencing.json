        "frames = A.build_upload(b\"\\x44\" * 300, A.FB_STATIC)",
        "# --no-mode: upload only",
        "A.upload_content(bus, frames, A.MODE_STATIC, is_gif=False, set_display_mode=False)",
        "assert bus.writes == frames"
      ],
