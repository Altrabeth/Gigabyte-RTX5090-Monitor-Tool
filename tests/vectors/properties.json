      "lines": "229-244",
      "stated": [
        "payload, n, d = A.build_gif_payload(p)",
        "assert n == 7",
        "assert d == 50, \"header delay = average gif frame duration in ms\"",
        "assert struct.unpack_from(\"<H\", payload, 0)[0] == 7",
        "pos = cum = 2 + 10 * n",
