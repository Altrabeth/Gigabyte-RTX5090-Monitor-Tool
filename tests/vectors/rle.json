    {
      "name": "gif_frame_table_offsets",
      "source": "tests/test_encoders.py::test_gif_frame_table_offsets",
      "lines": "204-213",
      "stated": [
        "# sizes [10, 20], N=2: header = 2 + 10*2 = 22 bytes.",
        "# entry u32 = inclusive end offset: 22+10-1 = 31, then 32+20-1 = 51.",
        "t = A.gif_frame_table([10, 20])",
        "assert struct.unpack_from(\"<H\", t, 0)[0] == 2",
        "e0 = struct.unpack_from(\"<IHHH\", t, 2)",
        "e1 = struct.unpack_from(\"<IHHH\", t, 12)",
        "assert e0 == (31, A.W, A.H, 3)",
        "assert e1 == (51, A.W, A.H, 3)",
        "assert len(t) == 22"
      ],
      "call": "gif_frame_table",
      "input": { "sizes": [10, 20] },
      "expect": {
        "len": 22,
        "at": [
          { "offset": 0, "u16le": [2] },
          { "offset": 2, "u32le": [31] },
          { "offset": 6, "u16le": [320, 170, 3] },
          { "offset": 12, "u32le": [51] },
          { "offset": 16, "u16le": [320, 170, 3] }
        ]
      }
    },
    {
      "name": "selftest_gif_table",
