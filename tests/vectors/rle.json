    {
      "name": "rle_literal_then_run",
      "source": "tests/test_encoders.py::test_rle_literal_then_run",
      "lines": "179-184",
      "stated": [
        "px = _px(1, 2) + _px(*[9] * 4) + _px(5, 6, 7, 8, 5, 6)",
        "got = A.rle_encode_frame(px)",
        "assert got == (b\"\\x02\\x00\" + _px(1, 2)",
        "+ b\"\\x04\\x80\" + _px(9)",
        "+ b\"\\x06\\x00\" + _px(5, 6, 7, 8, 5, 6))"
      ],
      "call": "rle_encode_frame",
      "input": {
        "px": [
          { "u16le": [1, 2] },
          { "u16le": [9], "repeat": 4 },
          { "u16le": [5, 6, 7, 8, 5, 6] }
        ]
      },
      "expect": {
        "exact": [
          { "hex": "02 00" }, { "u16le": [1, 2] },
          { "hex": "04 80" }, { "u16le": [9] },
          { "hex": "06 00" }, { "u16le": [5, 6, 7, 8, 5, 6] }
        ]
      }
    },
