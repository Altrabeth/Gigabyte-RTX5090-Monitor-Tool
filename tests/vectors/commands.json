      "name": "open_lcd_on",
      "source": "tests/test_encoders.py::test_command_frames_on_the_wire",
      "lines": "335-350",
      "stated": [
        "A.open_lcd(bus, True)",
        "ops = [(w[0], w[5], w[6:9]) for w in bus.writes]",
        "assert ops[0][:2] == (0xE7, 1)",
        "assert all(w[1:5] == A.MAGIC and len(w) == 256 for w in bus.writes)"
      ],
      "call": "open_lcd",
      "input": { "on": true },
      "expect": {
        "len": 256,
        "at": [
          { "offset": 0, "hex": "e7" },
          { "offset": 1, "hex": "cb 55 ac 38" },
          { "offset": 5, "u8": [1] }
        ]
      }
