# Maintainer: Altrabeth <https://github.com/Altrabeth>

pkgname=aorus-lcd
_repo=Gigabyte-RTX5090-Monitor-Tool
pkgver=0.1.0
pkgrel=1
pkgdesc='Drives the LCD Edge View panel of the Gigabyte AORUS RTX 5090 Master'
arch=('x86_64')
url="https://github.com/Altrabeth/$_repo"
# The binary embeds DejaVu Sans Bold, so the font's terms apply to it as well as
# MIT. SPDX has an id for Bitstream Vera but none for Arev, hence the LicenseRef.
license=('MIT' 'Bitstream-Vera' 'LicenseRef-Arev')
# libgcc and glibc are what the binary links. nvidia-utils is needed at run time
# only: NVML is loaded with dlopen, so namcap reports it as possibly unneeded.
depends=('glibc' 'libgcc' 'nvidia-utils')
makedepends=('cargo')
# Cargo's profile already strips the binary, so a debug package has no symbols.
options=('!debug')
backup=('etc/aorus-lcd.toml')
install=aorus-lcd.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('651455f0b6f003a183460ca3056f0cf657861424383b76319700d29588567f3f')

prepare() {
  cd "$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked --offline
}

check() {
  cd "$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # These never touch hardware or read /etc/aorus-lcd.toml, so they pass on any
  # build machine, with or without the card.
  cargo test --release --locked --offline
}

package() {
  cd "$_repo-$pkgver"

  install -Dm755 target/release/aorus-lcd "$pkgdir/usr/bin/aorus-lcd"

  # The unit in dist/ matches the README's manual install to /usr/local/bin. A
  # package that kept that path would give a unit that cannot start, so stop here
  # if the line ever changes shape and this sed misses it.
  sed 's|^ExecStart=/usr/local/bin/aorus-lcd |ExecStart=/usr/bin/aorus-lcd |' \
    dist/aorus-lcd.service > "$srcdir/aorus-lcd.service"
  if ! grep -q '^ExecStart=/usr/bin/aorus-lcd ' "$srcdir/aorus-lcd.service"; then
    echo 'package: failed to patch ExecStart in dist/aorus-lcd.service' >&2
    return 1
  fi
  install -Dm644 "$srcdir/aorus-lcd.service" \
    "$pkgdir/usr/lib/systemd/system/aorus-lcd.service"

  install -Dm644 dist/aorus-lcd.sysusers "$pkgdir/usr/lib/sysusers.d/aorus-lcd.conf"
  install -Dm644 dist/aorus-lcd.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/aorus-lcd.conf"
  install -Dm644 dist/i2c-dev.conf "$pkgdir/usr/lib/modules-load.d/i2c-dev.conf"
  install -Dm644 dist/99-i2c.rules "$pkgdir/usr/lib/udev/rules.d/99-i2c.rules"
  install -Dm644 dist/aorus-lcd.toml "$pkgdir/etc/aorus-lcd.toml"

  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    LICENSE assets/DejaVuSans-Bold.LICENSE

  # namcap wants a file for each license identifier that pacman does not ship.
  # The DejaVu file covers Bitstream-Vera and Arev, so its Arev section also
  # goes in a file of its own, word for word.
  sed -n '/^Arev Fonts Copyright$/,/^TeX Gyre DJV Math$/p' assets/DejaVuSans-Bold.LICENSE |
    sed '$d' > "$srcdir/LicenseRef-Arev"
  if ! grep -q 'Copyright (c) 2006 by Tavmjong Bah' "$srcdir/LicenseRef-Arev"; then
    echo 'package: failed to extract the Arev section of the DejaVu license' >&2
    return 1
  fi
  install -Dm644 "$srcdir/LicenseRef-Arev" "$pkgdir/usr/share/licenses/$pkgname/LicenseRef-Arev"
}
